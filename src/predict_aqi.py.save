import joblib
import numpy as np
import mysql.connector
import datetime

class MyStandardScaler:
    def transform(self, X):
        return (X - self.mean) / (self.std + 1e-8)

class MyLabelEncoder:
    def inverse_transform(self, y_indices):
        return [self.inverse_classes[i] for i in y_indices]

class MyLinearRegression:
    def predict(self, X):
        return np.dot(X, self.weights) + self.bias

class MyLogisticRegression:
    def _sigmoid(self, z):
        return 1 / (1 + np.exp(-z))
    def predict_proba(self, X):
        linear_model = np.dot(X, self.weights) + self.bias
        return self._sigmoid(linear_model)

class MyNeuralNetwork:
    def _sigmoid(self, z):
        return 1 / (1 + np.exp(-z))
    def predict(self, X):
        z1 = np.dot(X, self.W1) + self.b1
        a1 = self._sigmoid(z1)
        z2 = np.dot(a1, self.W2) + self.b2
        output = self._sigmoid(z2)
        return np.argmax(output, axis=1)

db_config = {
    'user': 'root',
    'password': 'password', 
    'host': 'localhost',
    'database': 'AqiAnalysisDB'
}

def get_aqi_category(aqi):
    if aqi <= 50: return "Good"
    elif aqi <= 100: return "Satisfactory"
    elif aqi <= 200: return "Moderate"
    elif aqi <= 300: return "Poor"
    elif aqi <= 400: return "Very Poor"
    else: return "Severe"

def make_prediction():
    # 1. Load the Brain
    try:
        data = joblib.load('all_models_manual.pkl')
        lin_reg = data['linear']
        log_reg = data['logistic']
        nn_model = data['neural_net']
        scaler = data['scaler']
        le = data['encoder']
    except FileNotFoundError:
        print("❌ Error: 'all_models_manual.pkl' not found. Run train_model.py first!")
        return

    # 2. Get User Inputs
    print("\n--- 🤖 MANUAL AI SYSTEM (Safe Mode) ---")
    try:
        fire_count = float(input("Punjab Fire Count: "))
        wind_speed = float(input("Wind Speed (km/h): "))
        wind_dir = float(input("Wind Direction (deg): "))
        temp = float(input("Temperature (C): "))
    except ValueError:
        print("❌ Invalid input. Please enter numbers only.")
        return

    # 3. AI Calculation
    input_array = np.array([[fire_count, wind_speed, wind_dir, temp]])
    input_scaled = scaler.transform(input_array)

    pred_aqi = lin_reg.predict(input_scaled)[0]
    prob = log_reg.predict_proba(input_scaled)[0]
    is_severe = bool(prob > 0.5)
    reason_idx = nn_model.predict(input_scaled)[0]
    pred_reason_str = le.inverse_transform([reason_idx])[0]

    # 4. Show Results (This will ALWAYS work)
    print("\n" + "="*30)
    print(f"🔮 PREDICTION RESULT")
    print(f"Predicted AQI: {pred_aqi:.2f}")
    print(f"High Risk Probability: {prob*100:.1f}%")
    print(f"Dominant Cause: {pred_reason_str}")
    print("="*30)

    # 5. Try Database (But don't crash if it fails)
    save_success = save_to_log(fire_count, wind_speed, pred_aqi, is_severe, pred_reason_str)

    if save_success:
        user_feedback = input("\nAdd this prediction to Training Data? (y/n): ")
        if user_feedback.lower() == 'y':
            add_to_training(fire_count, wind_speed, wind_dir, temp, pred_aqi, pred_reason_str)
    else:
        print("\n⚠️  Note: Database is OFFLINE. Result shown but not saved.")

def save_to_log(fire, wind, aqi, risk, cause):
    try:
        conn = mysql.connector.connect(**db_config)
        cursor = conn.cursor()
        
        sql = """
        INSERT INTO Prediction_Log 
        (input_fire_count, input_wind_speed, predicted_aqi, is_severe_risk, root_cause)
        VALUES (%s, %s, %s, %s, %s)
        """
        cursor.execute(sql, (fire, wind, float(aqi), risk, cause))
        conn.commit()
        
        # Trigger the Stored Procedure for the Alert
        cursor.callproc('Generate_Alert', [float(aqi), cause])
        for result in cursor.stored_results():
            msg = result.fetchone()[0]
            print(f"\n📢 DATABASE ALERT: {msg}")
            
        return True # Success

    except mysql.connector.Error:
        return False # Failed, but we handled it silently

def add_to_training(fire, wind, direction, temp, aqi, cause):
    # Always save to CSV (File system usually works even if DB doesn't)
    today = datetime.date.today()
    category = get_aqi_category(aqi)
    csv_line = f"\n{today},{int(fire)},{wind},{direction},{temp},{int(aqi)},{category},{cause}"
    
    try:
        with open('../data/delhi_aqi_data.csv', 'a') as f:
            f.write(csv_line)
        print("✅ Added to CSV file.")
    except Exception as e:
        print(f"❌ Could not save to CSV: {e}")

    # Try saving to DB
    try:
        conn = mysql.connector.connect(**db_config)
        cursor = conn.cursor()
        sql = """
        INSERT INTO Training_Data 
        (date, punjab_fire_count, wind_speed_kmph, wind_dir_deg, temp_min_c, delhi_aqi, aqi_category, dominant_reason)
        VALUES (%s, %s, %s, %s, %s, %s, %s, %s)
        """
        cursor.execute(sql, (today, fire, wind, direction, temp, aqi, category, cause))
        conn.commit()
        print("✅ Added to Database Training Table.")
    except mysql.connector.Error:
        print("⚠️  Could not add to Database (Server Offline).")

if __name__ == "__main__":
    make_prediction()
